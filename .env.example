# Copia este archivo como .env y pega tu clave.
# Clave gratuita de Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_aqui_tu_clave

# Tamaño del modelo Whisper local (tiny, base, small, medium). Se descarga la primera vez.
# WHISPER_LOCAL=small

# Opcional: usar Groq en lugar de Gemini (clave gratuita en https://console.groq.com/keys).
# Si existe GROQ_API_KEY, la transcripción con Whisper se hace por la API de Groq.
# GROQ_API_KEY=gsk_...
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# MODELO_CHAT=llama-3.3-70b-versatile
# PROVEEDOR=Groq (capa gratuita)
